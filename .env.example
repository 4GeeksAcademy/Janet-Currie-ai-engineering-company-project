# Copy to .env (gitignored) before `docker compose up`.
# Placeholders only — never put real secrets in this file.
#
# After first boot (optional, uses image system packages — not host .venv):
#   docker compose exec backend python -m app.auth.seed
#   docker compose exec backend python -m app.inventory.seed
#   docker compose exec backend python -m app.seed

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

SECRET_KEY=change-me-in-local-dev
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_BASE_URL=http://localhost:3001
RESEND_API_KEY=
RESEND_FROM_EMAIL=HealthCore Digital <noreply@healthcore.example>
DATABASE_URL=
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
# Celery broker/result. Compose services override this to redis://redis:6379/0.
# Host uvicorn / pytest against published Redis:
REDIS_URL=redis://localhost:6379/0

# Knowledge helper. Placeholders only. Copy the two model ids from the 4Geeks
# student access page after you confirm they are different. Do not guess them.
# LLM_BASE_URL should include the provider's /v1 prefix when it uses one.
LLM_API_KEY=
LLM_BASE_URL=
EMBEDDING_MODEL_ID=
GENERATION_MODEL_ID=
# Compose sets this to http://qdrant:6333 for the API container.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=healthcore_knowledge
RETRIEVAL_K=5
# Leave blank until the practice questions have been scored. Do not guess.
RAG_MIN_SCORE=
GENERATION_TIMEOUT_SECONDS=20
GENERATION_MAX_TOKENS=400
# Keep off. Set to true only on a local machine when you mean to log questions.
RAG_LOG_QUESTIONS=
