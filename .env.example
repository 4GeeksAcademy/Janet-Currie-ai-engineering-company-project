# Copy to .env (gitignored) before `docker compose up`.
# Placeholders only — never put real secrets in this file.
#
# After first boot (optional, uses image system packages — not host .venv):
#   docker compose exec backend python -m app.auth.seed
#   docker compose exec backend python -m app.inventory.seed
#   docker compose exec backend python -m app.seed

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

