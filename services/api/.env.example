RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_BASE_URL=http://localhost:3001
RESEND_API_KEY=
RESEND_FROM_EMAIL=HealthCore Digital <beth.t@example.com>
AUTH_SEED_ADMIN_EMAIL=admin@healthcore.example
